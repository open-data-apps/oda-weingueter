{
  "$schema": "https://frictionlessdata.io/schemas/table-schema.json",
  "fields": [
    {
      "name": "id",
      "type": "string",
      "description": "Eindeutige URI oder Kennung des Weinorts im DZT Knowledge Graph"
    },
    {
      "name": "name",
      "type": "string",
      "description": "Name des Weinguts, der Vinothek oder Weinstube"
    },
    {
      "name": "type",
      "type": "string",
      "description": "Schema.org Typ (https://schema.org/Winery)"
    },
    {
      "name": "categories",
      "type": "string",
      "description": "Klassifizierte Erlebnis-Kategorien (weingut, vinothek, besen, weinstube, probe)"
    },
    {
      "name": "description",
      "type": "string",
      "description": "Ausführliche Beschreibung des Betriebs und Weinsortiments"
    },
    {
      "name": "latitude",
      "type": "number",
      "description": "Geografischer Breitengrad (WGS84)"
    },
    {
      "name": "longitude",
      "type": "number",
      "description": "Geografischer Längengrad (WGS84)"
    },
    {
      "name": "street",
      "type": "string",
      "description": "Straße und Hausnummer"
    },
    {
      "name": "postalCode",
      "type": "string",
      "description": "Postleitzahl"
    },
    {
      "name": "city",
      "type": "string",
      "description": "Gemeinde / Stadt"
    },
    {
      "name": "distanceKm",
      "type": "number",
      "description": "Berechnete Luftlinien-Entfernung zum Instanz-Zentrum in Kilometern"
    },
    {
      "name": "telephone",
      "type": "string",
      "description": "Telefonnummer des Betriebs"
    },
    {
      "name": "url",
      "type": "string",
      "format": "uri",
      "description": "Offizielle Website des Betriebs"
    },
    {
      "name": "hasMenu",
      "type": "string",
      "format": "uri",
      "description": "Link zur Weinkarte / Speisekarte"
    },
    {
      "name": "imageUrl",
      "type": "string",
      "format": "uri",
      "description": "URL zum Vorschaubild"
    },
    {
      "name": "license",
      "type": "string",
      "description": "Open Data Lizenz (z. B. CC BY 4.0, CC0)"
    }
  ]
}
